{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "hpchat",
  // nodejs_compat é obrigatório: o app usa node:crypto (HMAC, hash, random).
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Domínio personalizado de produção. Requer que a zona
  // loteriaencruzilhada.com.br esteja na mesma conta Cloudflare — o Wrangler
  // provisiona o domínio e o TLS automaticamente no deploy.
  "routes": [
    {
      "pattern": "chat.loteriaencruzilhada.com.br",
      "custom_domain": true
    }
  ]
}
